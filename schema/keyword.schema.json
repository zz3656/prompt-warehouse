{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prompt-warehouse.dev/schema/keyword.json",
  "title": "PWS Keyword",
  "description": "A structured keyword/tag in the Prompt Warehouse Standard",
  "type": "object",
  "required": ["id", "term", "category", "subcategory"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Unique identifier in format: {category}_{subcategory}_{slug}"
    },
    "term": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Canonical prompt term in English"
    },
    "term_zh": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "中文翻译 — Chinese translation of the canonical prompt term"
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 10
    },
    "aliases_zh": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 10,
      "description": "中文替代术语 — Chinese alternative terms / colloquial translations"
    },
    "labels_zh": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 20,
      "description": "中文搜索标签 — Chinese labels for flat search indexing"
    },
    "category": {
      "type": "string",
      "enum": [
        "quality", "composition", "lighting", "character",
        "clothing", "styles", "negative", "scene", "panel"
      ]
    },
    "subcategory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "labels": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 20
    },
    "labels_zh": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 20,
      "description": "中文搜索标签 — Chinese labels for flat search indexing"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5
    },
    "priority": {
      "type": "string",
      "enum": ["high", "medium", "low", "experimental"],
      "default": "medium"
    },
    "lifecycle": {
      "type": "string",
      "enum": ["draft", "review", "approved", "deprecated", "archived"],
      "default": "draft"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 10
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "maxLength": 200 },
    "usage_count": { "type": "integer", "minimum": 0, "default": 0 },
    "success_rate": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "notes": { "type": "string", "maxLength": 1000 },
    "variations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "context"],
        "properties": {
          "term": { "type": "string" },
          "context": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
