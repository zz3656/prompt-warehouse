{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prompt-warehouse.dev/schema/keyword.json",
  "title": "PWS Keyword",
  "description": "A structured keyword/tag in the Prompt Warehouse Standard",
  "type": "object",
  "required": [
    "id",
    "term",
    "category",
    "subcategory"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Unique identifier in format: {category}_{subcategory}_{slug}"
    },
    "term": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Canonical prompt term in English"
    },
    "labels_zh": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 20,
      "description": "中文搜索标签 — Chinese labels for flat search indexing"
    },
    "category": {
      "type": "string",
      "enum": [
        "action-fx",
        "atmosphere",
        "character",
        "character-fx",
        "clothing",
        "color-look",
        "composition",
        "era",
        "held-prop",
        "lighting",
        "material",
        "negative",
        "panel",
        "photographer",
        "quality",
        "scene",
        "shot-language",
        "styles",
        "temporal",
        "transitions",
        "uncategorized"
      ]
    },
    "subcategory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 20
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "archived"
      ],
      "default": "draft"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "maxLength": 200
    },
    "usage_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 5000
    },
    "compatibility": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sdxl",
          "midjourney",
          "flux",
          "kling",
          "runway",
          "minimax_h3"
        ]
      },
      "description": "适用的 AI 模型列表"
    },
    "alias_of": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "指向 canonical 关键词的 id（同义重复时，非 canonical 项标记此项）"
    },
    "relation_group": {
      "type": "string",
      "description": "跨分类重复的分组标识（跨分类不同义时，同组 term 共享此 ID）"
    },
    "relation_role": {
      "type": "string",
      "enum": [
        "canonical",
        "variant"
      ],
      "description": "在 relation_group 中的角色：canonical 为主条目，variant 为变体"
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "组合权重，与 score 解耦。PanelCraft 排序用；缺失时回退到 score"
    },
    "is_negative": {
      "type": "boolean",
      "description": "true 表示负面词，PanelCraft 应走独立通道，不参与正面词排序"
    },
    "subcategory_group": {
      "type": "string",
      "description": "子分类的逻辑分组，用于 UI 归类。如 midjourney_v5 前缀的归为一组"
    },
    "term_zh": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200,
      "description": "Chinese translation. Optional — omit or set to null when untranslated."
    }
  },
  "additionalProperties": true,
  "patternProperties": {
    "^_": {
      "description": "Private/internal fields starting with underscore (e.g., _source_file, _translated_auto)"
    }
  }
}