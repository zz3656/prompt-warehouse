{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prompt-warehouse.dev/schema/bundle.json",
  "title": "PWS Prompt Bundle",
  "description": "A curated combination of keyword IDs, weights, and template references that form a reusable prompt recipe.",
  "type": "object",
  "required": [
    "id",
    "name",
    "name_zh",
    "keywords",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "description": "Unique identifier for the bundle. Format: {category}.{subcategory}.{slug}"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Bundle name in English."
    },
    "name_zh": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Bundle name in Chinese."
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "description": "English description of what the bundle does and when to use it."
    },
    "description_zh": {
      "type": "string",
      "maxLength": 2000,
      "description": "中文描述 — Chinese description of the bundle."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the bundle."
    },
    "category": {
      "type": "string",
      "description": "High-level category (e.g. 'photography', 'video-generation', 'character-design')."
    },
    "subcategories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for bundle discoverability."
    },
    "api_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SDXL",
          "Midjourney",
          "DALL-E",
          "Flux",
          "Stable Diffusion",
          "Minimax-H3",
          "Minimax H3",
          "GPT Image",
          "Runway",
          "Kling",
          "Custom"
        ]
      },
      "description": "Target AI models this bundle works best with."
    },
    "keywords": {
      "type": "array",
      "description": "关键词列表，每项含 id 和 weight",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "templates": {
      "type": "array",
      "description": "引用的模板，可以是字符串（template_id）或对象 {template_id, variant_id, variables}",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "template_id": {
                "type": "string"
              },
              "variant_id": {
                "type": "string"
              },
              "variables": {
                "type": "object"
              }
            }
          }
        ]
      }
    },
    "prompt_text": {
      "type": "string",
      "maxLength": 3000,
      "description": "Pre-built prompt text (optional). When provided, pws-bundles.py can skip resolution and use this directly."
    },
    "example": {
      "type": "object",
      "description": "Example input/output showing how the bundle works.",
      "properties": {
        "description": {
          "type": "string"
        },
        "description_zh": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string"
            },
            "setting": {
              "type": "string"
            },
            "additional": {
              "type": "object"
            }
          }
        },
        "output": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "deprecated",
        "archived"
      ],
      "default": "draft"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "bundle_type": {
      "type": "string",
      "enum": [
        "keywords_only",
        "with_template"
      ],
      "description": "纯关键词配方 or 含模板引用"
    },
    "keyword_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "该 bundle 引用的关键词所属的分类（由系统自动生成，不手动编辑）"
    },
    "prompt_text_zh": {
      "type": "string",
      "maxLength": 3000,
      "description": "预建中文提示词文本"
    }
  },
  "additionalProperties": true
}