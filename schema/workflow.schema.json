{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow",
  "description": "提示词工作流（模板组合）",
  "type": "object",
  "required": ["id", "name", "name_zh", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^workflow\\.[a-z][a-z0-9_]*$"
    },
    "name": { "type": "string" },
    "name_zh": { "type": "string" },
    "description": { "type": "string" },
    "description_zh": { "type": "string" },
    "use_case": {
      "type": "array",
      "items": { "type": "string" }
    },
    "api_targets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "output_format": {
      "type": "string",
      "enum": ["comma_separated", "structured", "json"]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "template_id"],
        "properties": {
          "order": { "type": "integer" },
          "template_id": { "type": "string" },
          "required": { "type": "boolean" },
          "description_zh": { "type": "string" }
        }
      }
    },
    "example_output": { "type": "string" },
    "created_at": { "type": "string" },
    "version": { "type": "string" }
  }
}
