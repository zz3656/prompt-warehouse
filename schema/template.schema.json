{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prompt-warehouse.dev/schema/template.json",
  "title": "PWS Template",
  "description": "A reusable prompt template with variable placeholders",
  "type": "object",
  "required": ["id", "name", "variants"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 1000 },
    "category": { "type": "string" },
    "subcategories": { "type": "array", "items": { "type": "string" } },
    "language": { "type": "string", "default": "en" },
    "api_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["SDXL", "Midjourney", "DALL-E", "Flux", "Stable Diffusion", "Custom"]
      }
    },
    "lifecycle": {
      "type": "string",
      "enum": ["draft", "review", "approved", "deprecated", "archived"],
      "default": "draft"
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
          "type": { "type": "string", "enum": ["string", "string[]", "number", "boolean"] },
          "required": { "type": "boolean", "default": false },
          "default": {},
          "description": { "type": "string" }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "template"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+$" },
          "description": { "type": "string" },
          "template": { "type": "string" }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input": { "type": "object" },
          "output": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "additionalProperties": false
}
