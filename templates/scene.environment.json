        "indoor",
        "urban",
        "nature",
        "fantastical"
      ],
      "required": true
    },
    {
      "name": "key_objects",
      "description": "Key objects in scene",
      "description_zh": "场景关键物体",
      "source": "keyword",
      "category": "scene",
      "subcategory": "mj_v5_objects",
      "required": true
    },
    {
      "name": "nature_elements",
      "description": "Natural elements",
      "description_zh": "自然元素",
